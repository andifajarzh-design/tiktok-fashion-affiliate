      // 2. Set tahun copyright otomatis
      const yearEl = document.getElementById("current-year");
      if (yearEl) {
        yearEl.textContent = new Date().getFullYear();
      }

      // 3. Countdown Timer Dinamis (Evergreen 2 jam 45 menit, tersimpan di sessionStorage)
      const timerEl = document.getElementById("countdown-timer");
      if (timerEl) {
        const DURATION_MS = (2 * 3600 + 45 * 60 + 19) * 1000;
        let endTime = sessionStorage.getItem("promo_end_time");

        if (!endTime || Number(endTime) <= Date.now()) {
          endTime = Date.now() + DURATION_MS;
          sessionStorage.setItem("promo_end_time", String(endTime));
        }

        const updateTimer = () => {
          const remaining = Math.max(0, Number(endTime) - Date.now());
          const hours = Math.floor(remaining / (1000 * 60 * 60));
          const minutes = Math.floor((remaining % (1000 * 60 * 60)) / (1000 * 60));
          const seconds = Math.floor((remaining % (1000 * 60)) / 1000);

          const pad = (n) => String(n).padStart(2, "0");
          timerEl.textContent = `${pad(hours)}:${pad(minutes)}:${pad(seconds)}`;

          if (remaining === 0) {
            endTime = Date.now() + DURATION_MS;
            sessionStorage.setItem("promo_end_time", String(endTime));
          }
        };

        updateTimer();
        setInterval(updateTimer, 1000);
      }

      // 4. Simulasi Mockup Interaktif di Hero Section
      const demoData = {
        threads: {
          input: '"Ebook & Template Keuangan untuk Freelancer Pemula"',
          outputs: [
            "1/ Banyak freelancer penghasilannya naik, tapi akhir bulan tetap habis entah ke mana. Masalahnya bukan kurang proyek, tapi sistem cashflow yang berantakan.\n\n2/ Dulu saya juga gitu, sampai akhirnya bikin 1 dashboard sederhana buat misahin uang proyek, pajak, dan dana darurat otomatis.\n\n3/ Kalau mau langsung pakai tanpa pusing bikin rumus dari nol, cek link di bio ya. Sekali bayar, pakai selamanya! 👇",
            "1/ Kesalahan terbesar freelancer pas baru dapet klien besar: uang masuk langsung dicampur sama rekening jajan.\n\n2/ Akibatnya pas proyek sepi, langsung panik cari pinjaman. Padahal kuncinya cuma 1: punya tracker cashflow harian yang simpel.\n\n3/ Saya sudah rangkum template siap pakainya di Lynk.id, tinggal klik link di bio kalau mau langsung rapihin keuanganmu hari ini."
          ]
        },
        tiktok: {
          input: '"Skrip Video 30 Detik Jualan Web AI Tool Tanpa Langganan"',
          outputs: [
            "[HOOK 0-3s]: Stop bayar 300 ribu tiap bulan cuma buat bikin konten AI!\n\n[ISI 4-20s]: Sekarang kamu bisa pakai Web AI Generator yang cukup dibayar sekali aja. Langsung jalan di browser HP, tinggal pilih template, masukin topik, klik generate—jadi deh skrip siap rekam!\n\n[CTA 21-30s]: Mumpung masih harga promo 49 ribu, langsung klik keranjang / link di bio sekarang!",
            "[HOOK 0-3s]: Rahasia kreator bisa upload 3 konten sehari tanpa begadang!\n\n[ISI 4-20s]: Bukan pakai tim besar, tapi pakai tool AI praktis yang sudah disetting khusus bahasa Indonesia yang natural. Nggak kaku kayak robot.\n\n[CTA 21-30s]: Mau coba juga? Cek link Lynk.id di bio aku sebelum promonya habis!"
          ]
        },
        landing: {
          input: '"Headline & Subheadline Produk Digital untuk UMKM"',
          outputs: [
            "HEADLINE: Ubah Followers Jadi Pembeli Tanpa Pusing Mikirin Kata-Kata Jualan!\n\nSUBHEADLINE: Dapatkan 100+ formula copywriting siap pakai yang terbukti menaikkan klik dan konversi di WhatsApp, Instagram, dan TikTok. Sekali bayar, langsung pakai hari ini.",
            "HEADLINE: Jualan Online Sepi? Mungkin Bukan Produknya yang Salah, Tapi Cara Penawarannya.\n\nSUBHEADLINE: Gunakan panduan & template promosi praktis ini untuk merangkai penawaran yang bikin calon pembeli langsung klik tombol beli tanpa mikir dua kali."
          ]
        }
      };

      let activeTab = "threads";
      let outputIndex = 0;

      const tabButtons = document.querySelectorAll(".demo-tab");
      const demoInputEl = document.getElementById("demo-input");
      const demoOutputEl = document.getElementById("demo-output");
      const demoGenBtn = document.getElementById("demo-generate-btn");

      const renderDemo = (animate = false) => {
        const current = demoData[activeTab];
        if (!current || !demoInputEl || !demoOutputEl) return;

        demoInputEl.textContent = current.input;

        if (animate) {
          demoOutputEl.style.opacity = "0.35";
          setTimeout(() => {
            demoOutputEl.textContent = current.outputs[outputIndex % current.outputs.length];
            demoOutputEl.style.opacity = "1";
          }, 180);
        } else {
          demoOutputEl.textContent = current.outputs[outputIndex % current.outputs.length];
        }
      };

      tabButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          activeTab = btn.getAttribute("data-demo") || "threads";
          outputIndex = 0;

          tabButtons.forEach((b) => {
            b.classList.remove("bg-indigo-600", "text-white");
            b.classList.add("bg-slate-800", "text-slate-300");
          });
          btn.classList.remove("bg-slate-800", "text-slate-300");
          btn.classList.add("bg-indigo-600", "text-white");

          renderDemo(true);
        });
      });

      if (demoGenBtn) {
        demoGenBtn.addEventListener("click", () => {
          outputIndex += 1;
          renderDemo(true);
        });
      }

      // 5. FAQ Accordion Interaktif
      const faqItems = document.querySelectorAll(".faq-item");
      faqItems.forEach((item) => {
        const trigger = item.querySelector(".faq-trigger");
        if (!trigger) return;

        trigger.addEventListener("click", () => {
          const isOpen = item.getAttribute("data-open") === "true";

          // Tutup semua item lain agar rapi
          faqItems.forEach((other) => other.setAttribute("data-open", "false"));

          // Toggle item yang diklik
          item.setAttribute("data-open", isOpen ? "false" : "true");
        });
      });
    });
  </script>
